{
  "name": "03 - GoPratle Telegram Intake Agent",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "e3a30003-0003-4000-8000-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const text = ($input.item.json.message?.text || '').trim();\n\n// Match patterns like \"Connect with event leads for [Company] in [City]\" or \"Research [Company] in [City]\"\nconst pattern = /(?:connect with (?:event )?leads for|research|find leads for)?\\s*([A-Za-z0-9\\s&.-]+?)\\s+(?:in|,|at)\\s+([A-Za-z\\s.-]+)/i;\nconst match = text.match(pattern);\n\nif (match) {\n  return {\n    json: {\n      raw_command: text,\n      Company_Name: match[1].trim(),\n      City: match[2].trim(),\n      chat_id: $input.item.json.message?.chat?.id,\n      isValid: true\n    }\n  };\n}\n\nreturn {\n  json: {\n    raw_command: text,\n    chat_id: $input.item.json.message?.chat?.id,\n    isValid: false,\n    error: 'Could not parse company and city. Example format: Connect with event leads for Zomato in Gurgaon'\n  }\n};"
      },
      "id": "e3a30003-0003-4000-8000-000000000002",
      "name": "Parse Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isValid }}",
              "value2": true
            }
          ]
        }
      },
      "id": "e3a30003-0003-4000-8000-000000000003",
      "name": "Validate Company/City",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        620,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID || 'GoPratle_BDR_Lead_Database' }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "Company_Name",
              "fieldValue": "={{ $json.Company_Name }}"
            },
            {
              "fieldId": "City",
              "fieldValue": "={{ $json.City }}"
            },
            {
              "fieldId": "Research_Status",
              "fieldValue": "Pending"
            },
            {
              "fieldId": "Outreach_Status",
              "fieldValue": "Not Ready"
            },
            {
              "fieldId": "Created_At",
              "fieldValue": "={{ $now.toISO() }}"
            },
            {
              "fieldId": "Updated_At",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "id": "e3a30003-0003-4000-8000-000000000004",
      "name": "Append Row to Leads Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        840,
        200
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "=✅ Added **{{ $json.Company_Name }}** ({{ $json.City }}) to the GoPratle BDR Lead Database. Lead enrichment workflow triggered!",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "e3a30003-0003-4000-8000-000000000005",
      "name": "Send Confirmation to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1060,
        200
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "=❌ **Command Parse Error:** {{ $json.error }}\\n\\nPlease try again with format:\\n`Connect with event leads for [Company] in [City]`",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "e3a30003-0003-4000-8000-000000000006",
      "name": "Send Error Help to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        840,
        420
      ]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Parse Command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Command": {
      "main": [
        [
          {
            "node": "Validate Company/City",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Company/City": {
      "main": [
        [
          {
            "node": "Append Row to Leads Sheet",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Error Help to Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Append Row to Leads Sheet": {
      "main": [
        [
          {
            "node": "Send Confirmation to Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}

