# ==============================================================================
# GoPratle BDR Lead Enrichment & Outreach Agent - Environment Configuration
# ==============================================================================
# Instructions: Copy this file to .env and replace placeholders with your actual keys.
# NEVER commit .env to GitHub or any version control system.

# ------------------------------------------------------------------------------
# 1. AI & Search API Keys (Required for Live Lead Research)
# ------------------------------------------------------------------------------
# Google Gemini API Key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Web Search API Key from Tavily: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 2. Google Workspace & Cloud Platform (Sheets & Gmail)
# ------------------------------------------------------------------------------
# Spreadsheet ID from the URL of your Google Sheet:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEETS_TAB_NAME=Leads

# Google OAuth Access Token (Required for standalone runner scripts calling Sheets/Gmail API)
# Can be generated via GCP OAuth Playground or Service Account
GOOGLE_ACCESS_TOKEN=your_oauth_access_token_here

# Google OAuth Client Credentials (for token refresh workflows)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here

# ------------------------------------------------------------------------------
# 3. Outreach Safety & Approvals (Crucial Demo Safety)
# ------------------------------------------------------------------------------
# Set TEST_MODE=true to re-route all drafts/test messages to your controlled test inbox
TEST_MODE=true
TEST_RECIPIENT_EMAIL=candidate_test_inbox@yourdomain.com

# Timing and Timezone Settings
FOLLOWUP_INTERVAL_DAYS=2
DEFAULT_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 4. n8n Orchestrator & Webhooks
# ------------------------------------------------------------------------------
# Full URL to your n8n production or test webhook endpoint
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/gopratle-lead-intake

# Optional Telegram Bot Token (for Phase 2 mobile command intake)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
