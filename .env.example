# ==============================================================================
# GoPratle BDR Lead Enrichment & Outreach Agent - Environment Configuration
# ==============================================================================
# Instructions: Copy this file to .env and replace placeholders with your actual API keys.
# NEVER commit .env to version control.

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Web Search API Key (https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# Google Sheets Configuration
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEETS_TAB_NAME=Leads

# Google Cloud OAuth Credentials (Optional if using n8n OAuth credential manager)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Controlled Outreach Safety Settings
# Set TEST_MODE=true during demos to re-route all drafts/sends to your test inbox
TEST_MODE=true
TEST_RECIPIENT_EMAIL=your_test_inbox@yourdomain.com

# Follow-up Automation Configuration
FOLLOWUP_INTERVAL_DAYS=2
DEFAULT_TIMEZONE=Asia/Kolkata

# Telegram Bot (Optional P1 Trigger)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
